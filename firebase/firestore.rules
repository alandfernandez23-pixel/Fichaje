rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function ubicacionValida() {
      return request.resource.data.keys().hasAll(['ubicacion'])
        && request.resource.data.ubicacion.lat > -53.79152
        && request.resource.data.ubicacion.lat < -53.79008
        && request.resource.data.ubicacion.lng > -67.69324
        && request.resource.data.ubicacion.lng < -67.69080;
    }

    function codigoQrValido() {
      return request.resource.data.keys().hasAll(['verificadoPorQR', 'codigoQR'])
        && request.resource.data.verificadoPorQR == true
        && request.resource.data.codigoQR == 'MQP-FICHAJE-INGRESO';
    }

    function esPropio() {
      return resource.data.uid == request.auth.uid
        || resource.data.email == request.auth.token.email;
    }

    match /fichajes/{fichajeId} {
      allow create: if request.auth != null
        && (
          (request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.horaSalida == null
            && (ubicacionValida() || codigoQrValido()))
          || esAdmin()
        );

      allow update: if request.auth != null
        && (
          (esPropio()
            && resource.data.horaSalida == null
            && request.resource.data.horaEntrada == resource.data.horaEntrada)
          || esAdmin()
        );

      allow read: if request.auth != null && (esPropio() || esAdmin());

      allow delete: if request.auth != null && esAdmin() && resource.data.eliminado == true;
    }

    match /admins/{adminEmail} {
      allow read: if request.auth != null;
      allow write: if esAdmin();
    }

    match /notasEmpleado/{notaId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || esAdmin());
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || esAdmin());
    }

    match /solicitudes/{solicitudId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.estado == 'pendiente';

      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || resource.data.email == request.auth.token.email
            || esAdmin());

      allow update: if request.auth != null
        && (
          esAdmin()
          || (resource.data.email == request.auth.token.email
              && resource.data.estado == 'pendiente'
              && request.resource.data.estado == 'cancelada')
        );

      allow delete: if false;
    }

    match /horarios/{horarioId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && esAdmin();
    }

    match /reemplazos/{reemplazoId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.estado == 'abierto';

      allow update: if request.auth != null
        && (
          (resource.data.estado == 'abierto'
            && request.resource.data.estado == 'cubierto'
            && request.resource.data.cubiertoPorEmail == request.auth.token.email)
          || resource.data.email == request.auth.token.email
          || esAdmin()
        );

      allow delete: if request.auth != null
        && (resource.data.email == request.auth.token.email || esAdmin());
    }

  }
}
